# Discord Bot Token (Lấy từ Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID (Lấy từ Discord Developer Portal > General Information)
CLIENT_ID=your_client_id_here

# Port cho Healthcheck HTTP Server trên Railway (mặc định 3000)
PORT=3000

# Đường dẫn file SQLite database (mặc định: data/database.sqlite)
DATABASE_PATH=data/database.sqlite

# Tùy chọn: ID của Guild thử nghiệm để đăng ký Slash Commands tức thì (bỏ trống nếu muốn đăng ký Global)
DEV_GUILD_ID=
